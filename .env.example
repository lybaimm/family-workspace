# Google Drive API Configuration
# ================================
# Option 1: OAuth 2.0 Client (Recommended for personal use)
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Option 2: Service Account (For shared/server use)
# Paste the entire JSON key as a single line, or base64 encode it
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Root folder ID in Google Drive to scope the app
# Create a folder called "Family Workspace" in Google Drive, 
# then copy its ID from the URL: https://drive.google.com/drive/folders/<THIS_IS_THE_ID>
GOOGLE_DRIVE_PARENT_FOLDER_ID=your_parent_folder_id_here

# Set to "true" to use mock data instead of real Google Drive API
USE_MOCK_DATA=true
